# Get these from https://my.telegram.org (API development tools)
API_ID=12345678
API_HASH=your_api_hash_here

# Get this from @BotFather on Telegram (create a NEW bot for this)
BOT_TOKEN=1234567890:your_bot_token_here

# MongoDB connection string.
# Local:  mongodb://localhost:27017
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=spotify_dl_bot

# How many tracks may download at the same time
MAX_CONCURRENT_DOWNLOADS=2

# Audio quality passed to spotdl (mp3). Use 128k to keep files small.
BITRATE=320k
